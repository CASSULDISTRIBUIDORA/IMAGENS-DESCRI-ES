{
  "name": "multipic",
  "version": "1.0.0",
  "description": "MultiPic — Centralizador e Editor de Imagens Multi-Formato",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:dir": "electron-builder --win --dir"
  },
  "author": "CASSUL",
  "license": "UNLICENSED",
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0"
  },
  "dependencies": {
    "@imgly/background-removal-node": "^1.4.5",
    "basic-ftp": "^6.2.0",
    "electron-updater": "^6.3.0",
    "sharp": "^0.33.0",
    "ssh2-sftp-client": "^12.1.1"
  },
  "build": {
    "appId": "com.cassul.multipic",
    "productName": "MultiPic",
    "icon": "build/icon.png",
    "asarUnpack": [
      "node_modules/@imgly/**",
      "node_modules/sharp/**",
      "node_modules/onnxruntime-node/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "OWNER",
        "repo": "multipic"
      }
    ],
    "extraResources": [
      {
        "from": "scripts",
        "to": "scripts",
        "filter": [
          "**/*"
        ]
      }
    ],
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "src/**/*",
      "node_modules/**/*"
    ]
  }
}
